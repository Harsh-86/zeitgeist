# Copy this file to docker/.env and fill in real values.
# docker/.env is gitignored — never commit real secrets.

# Anthropic API key for the llm-extractor service (console.anthropic.com).
# Set a monthly spend limit on the key/workspace before using it live.
ANTHROPIC_API_KEY=sk-ant-...

# Hard daily cap on LLM extraction calls (defense in depth alongside the
# spend limit set on the Anthropic key itself).
# 200 ≈ $17-18/month at measured $0.0029/call; 400 ≈ $35/month
LLM_MAX_CALLS_PER_DAY=200

# Optional: override the default Neo4j password used across services.
# NEO4J_PASSWORD=zeitgeist-dev

# Hard daily cap on entity-resolution (ER) calls made by the resolver
# service (screening + pair judging), sharing the same ANTHROPIC_API_KEY
# above. ~$0.0003/call, so 100/day is ~$0.03/day / ~$1/month.
ER_MAX_CALLS_PER_DAY=100
